{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release (Optimized)",
      "description": "Optimized release build with maximum speed, Link-Time Code Generation (LTCG/GL), and binary stripping/folding.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /Oi /Ot /Oy /GL /GF /Gy /Gw /DNDEBUG /fp:fast",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG /OPT:REF /OPT:ICF /INCREMENTAL:NO"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (Fast Incremental & Cached)",
      "description": "Fast CI build preset with compiler caching (sccache), incremental linking (/INCREMENTAL), embedded debug info (/Z7), and multiprocessor compilation (/MP).",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_FLAGS_RELEASE": "/O2 /Ob2 /Oi /Ot /Oy /GF /Gy /DNDEBUG /fp:fast /MP /Z7",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/INCREMENTAL"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with diagnostics and debug symbols.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "/Zi /Od /RTC1 /MDd /D_DEBUG"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "displayName": "Build CI",
      "configurePreset": "ci"
    },
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "displayName": "Test Release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "displayName": "Test CI",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "displayName": "Test Debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
